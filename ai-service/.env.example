# ==========================================
# DocuMind AI Service Environment Configuration
# ==========================================

# Server Configuration (Render default: 10000, Local default: 8000)
HOST=0.0.0.0
PORT=10000

# Google Gemini API Key (Required for embeddings & RAG Q&A)
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------------
# Database Configuration (Option A: Cloud Database URL, e.g. Supabase)
# -------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# -------------------------------------------------------------
# Database Configuration (Option B: Discrete Connection Parameters)
# -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=documind
DB_USER=documind_user
DB_PASSWORD=your_postgres_password_here
# DB_SSLMODE=require  # Required when connecting to Supabase / remote cloud

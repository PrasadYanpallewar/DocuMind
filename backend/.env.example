# ==========================================
# DocuMind Backend Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=documind
DB_USER=documind_user
DB_PASSWORD=your_postgres_password_here

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# FastAPI AI Service Endpoint (Deployed URL on Render or http://localhost:8000 for local)
AI_SERVICE_URL=https://documind-ai-yxgn.onrender.com

# ========================================================
# DocuMind - Root Environment Configuration Reference
# ========================================================
# DocuMind uses separate environment configurations for each service:
# - backend/.env      (Node.js API Gateway)
# - ai-service/.env   (Python FastAPI RAG Service)
#
# See backend/.env.example and ai-service/.env.example for details.
# ========================================================

# PostgreSQL & pgvector (Docker Compose defaults)
POSTGRES_DB=documind
POSTGRES_USER=documind_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_PORT=5432

# Backend Service
BACKEND_PORT=5000
JWT_SECRET=your_jwt_secret_key_here
AI_SERVICE_URL=https://documind-ai-yxgn.onrender.com

# AI Service
AI_SERVICE_PORT=8000
GEMINI_API_KEY=your_gemini_api_key_here
